<script>
(function () {
  var board = document.getElementById('board');
  var defs = [];

  function add(code, label, col, row, w, h, cls) {
    defs.push({ code: code, label: label, col: col, row: row, w: w || 4, h: h || 1, cls: cls || '' });
  }
  function T(t, b, a) { return { t: t, b: b, a: a }; }
  function Lt(l, a) { return { l: l, a: a }; }
  function run(row, col, items) {
    items.forEach(function (it) {
      add(it[0], it[1], col, row, it[2], 1, it[3]);
      col += it[2] || 4;
    });
  }
  function letters(str) {
    return str.split('').map(function (ch) { return ['Key' + ch, ch === 'E' ? Lt('E', '€') : ch]; });
  }

  /* Функціональний ряд (рядок 1) */
  add('Escape', 'Esc', 1, 1, 4, 1, 'mod');
  [[9, 1], [27, 5], [45, 9]].forEach(function (g) {
    for (var i = 0; i < 4; i++) add('F' + (g[1] + i), 'F' + (g[1] + i), g[0] + i * 4, 1, 4, 1, 'fn');
  });

  /* Цифровий ряд (рядок 3) */
  run(3, 1, [
    ['Backquote', T('|', '\\')], ['Digit1', T('!', '1')], ['Digit2', T('"', '2')], ['Digit3', T('£', '3')],
    ['Digit4', T('$', '4')], ['Digit5', T('%', '5')], ['Digit6', T('&', '6')], ['Digit7', T('/', '7')],
    ['Digit8', T('(', '8')], ['Digit9', T(')', '9')], ['Digit0', T('=', '0')], ['Minus', T('?', "'")],
    ['Equal', T('^', 'ì')], ['Backspace', '←', 8, 'big']
  ]);

  /* Ряд QWERTY (рядок 4) */
  run(4, 1, [['Tab', 'Tab', 6, 'mod']]
    .concat(letters('QWERTYUIOP').map(function (x) { return [x[0], x[1], 4]; }))
    .concat([['BracketLeft', T('é', 'è', '[')], ['BracketRight', T('*', '+', ']')]]));
  add('Enter', 'Invio', 55, 4, 6, 2, 'mod');

  /* Ряд ASDF (рядок 5) */
  run(5, 1, [['CapsLock', 'Caps\nLock', 6, 'mod']]
    .concat(letters('ASDFGHJKL').map(function (x) { return [x[0], x[1], 4]; }))
    .concat([['Semicolon', T('ç', 'ò', '@')], ['Quote', T('°', 'à', '#')], ['Backslash', T('§', 'ù')]]));

  /* Ряд ZXCV (рядок 6) */
  run(6, 1, [['ShiftLeft', '⇧', 5, 'big'], ['IntlBackslash', T('>', '<'), 4]]
    .concat(letters('ZXCVBNM').map(function (x) { return [x[0], x[1], 4]; }))
    .concat([['Comma', T(';', ','), 4], ['Period', T(':', '.'), 4], ['Slash', T('_', '-'), 4], ['ShiftRight', '⇧', 11, 'big']]));

  /* Нижній ряд (рядок 7) */
  run(7, 1, [
    ['ControlLeft', 'Ctrl', 5, 'mod'], ['MetaLeft', 'Win', 5, 'mod'], ['AltLeft', 'Alt', 5, 'mod'],
    ['Space', '', 25], ['AltRight', 'Alt Gr', 5, 'mod'], ['MetaRight', 'Win', 5, 'mod'],
    ['ContextMenu', '☰', 5, 'fn'], ['ControlRight', 'Ctrl', 5, 'mod']
  ]);

  /* Блок навігації (колонки 63–74) */
  add('PrintScreen', 'Stamp\nR Sist', 63, 1, 4, 1, 'mod');
  add('ScrollLock', 'Bloc\nScorr', 67, 1, 4, 1, 'mod');
  add('Pause', 'Pausa\nInterr', 71, 1, 4, 1, 'mod');
  add('Insert', 'Ins', 63, 3, 4, 1, 'fn');
  add('Home', '↖', 67, 3, 4, 1, 'fn');
  add('PageUp', 'Pag↑', 71, 3, 4, 1, 'fn');
  add('Delete', 'Canc', 63, 4, 4, 1, 'fn');
  add('End', 'Fine', 67, 4, 4, 1, 'fn');
  add('PageDown', 'Pag↓', 71, 4, 4, 1, 'fn');
  add('ArrowUp', '↑', 67, 6, 4, 1, 'big');
  add('ArrowLeft', '←', 63, 7, 4, 1, 'big');
  add('ArrowDown', '↓', 67, 7, 4, 1, 'big');
  add('ArrowRight', '→', 71, 7, 4, 1, 'big');

  /* Цифровий блок (колонки 77–92) */
  add('NumLock', 'Bloc\nNum', 77, 3, 4, 1, 'mod');
  add('NumpadDivide', '/', 81, 3);
  add('NumpadMultiply', '*', 85, 3);
  add('NumpadSubtract', '-', 89, 3);
  add('Numpad7', T('7', '↖'), 77, 4);
  add('Numpad8', T('8', '↑'), 81, 4);
  add('Numpad9', T('9', 'Pag↑'), 85, 4);
  add('NumpadAdd', '+', 89, 4, 4, 2);
  add('Numpad4', T('4', '←'), 77, 5);
  add('Numpad5', '5', 81, 5);
  add('Numpad6', T('6', '→'), 85, 5);
  add('Numpad1', T('1', 'Fine'), 77, 6);
  add('Numpad2', T('2', '↓'), 81, 6);
  add('Numpad3', T('3', 'Pag↓'), 85, 6);
  add('NumpadEnter', 'Invio', 89, 6, 4, 2, 'mod');
  add('Numpad0', T('0', 'Ins'), 77, 7, 8);
  add('NumpadDecimal', T('.', 'Canc'), 85, 7);

  /* ---------- Побудова DOM ---------- */
  function span(cls, text) {
    var s = document.createElement('span');
    s.className = cls;
    s.textContent = text;
    return s;
  }
  var map = {};
  var names = {};
  defs.forEach(function (d) {
    var b = document.createElement('button');
    b.type = 'button';
    b.tabIndex = -1;
    b.className = 'key' + (d.cls ? ' ' + d.cls : '');
    b.dataset.code = d.code;
    b.setAttribute('aria-label', d.code);
    b.style.gridColumn = d.col + ' / span ' + d.w;
    b.style.gridRow = d.row + ' / span ' + d.h;
    var L = d.label, name;
    if (typeof L === 'string') {
      if (L) b.appendChild(span('l', L));
      name = L ? L.replace('\n', ' ') : 'Space';
    } else if (L.t !== undefined) {
      b.classList.add('two');
      b.appendChild(span('t', L.t));
      b.appendChild(span('b' + (L.b.length > 1 ? ' sm' : ''), L.b));
      if (L.a) b.appendChild(span('a', L.a));
      name = L.b;
    } else {
      b.appendChild(span('l', L.l));
      if (L.a) b.appendChild(span('a', L.a));
      name = L.l;
    }
    names[d.code] = name;
    map[d.code] = b;
    board.appendChild(b);
  });

  /* ---------- Стан ---------- */
  var TOGGLES = { CapsLock: 'caps', NumLock: 'num', ScrollLock: 'scroll' };
  var state = { caps: false, num: true, scroll: false };
  var used = {};
  var usedCount = 0;
  var locked = false;
  var held = {};

  var lastEl = document.getElementById('last');
  var countEl = document.getElementById('count');
  var meterEl = document.getElementById('meter');
  var lockBtn = document.getElementById('lock');
  var resetBtn = document.getElementById('reset');

  function paintToggles() {
    Object.keys(TOGGLES).forEach(function (code) {
      var k = TOGGLES[code];
      map[code].classList.toggle('is-on', state[k]);
      document.getElementById('led-' + k).classList.toggle('on', state[k]);
    });
  }
  function paintCount() {
    countEl.textContent = usedCount + ' з ' + defs.length;
    meterEl.style.width = (usedCount / defs.length * 100) + '%';
  }
  function press(code, repeat, name) {
    var el = map[code];
    if (!el || locked) return;
    el.classList.add('is-down');
    if (!used[code]) {
      used[code] = true;
      usedCount++;
      el.classList.add('is-used');
      paintCount();
    }
    if (!repeat && TOGGLES[code]) {
      state[TOGGLES[code]] = !state[TOGGLES[code]];
      paintToggles();
    }
    lastEl.textContent = name || names[code];
  }
  function release(code) {
    if (map[code]) map[code].classList.remove('is-down');
  }
  function releaseAll() {
    Object.keys(map).forEach(release);
    held = {};
  }

  /* ---------- Фізична клавіатура ---------- */
  var PREVENT = { Space: 1, ArrowUp: 1, ArrowDown: 1, ArrowLeft: 1, ArrowRight: 1, PageUp: 1, PageDown: 1, Home: 1, End: 1, Backspace: 1, ContextMenu: 1, AltLeft: 1, AltRight: 1 };
  window.addEventListener('keydown', function (e) {
    if (locked || !map[e.code]) return;
    if (PREVENT[e.code] && !e.ctrlKey && !e.metaKey) e.preventDefault();
    press(e.code, e.repeat, e.key === ' ' ? 'Space' : e.key);
  });
  window.addEventListener('keyup', function (e) {
    if (e.code && e.code.indexOf('Meta') === 0) { releaseAll(); return; }
    release(e.code);
  });
  window.addEventListener('blur', releaseAll);

  /* ---------- Миша та дотик ---------- */
  board.addEventListener('pointerdown', function (e) {
    var b = e.target.closest ? e.target.closest('.key') : null;
    if (!b || locked) return;
    held[e.pointerId] = b.dataset.code;
    press(b.dataset.code, false);
  });
  function pointerUp(e) {
    var code = held[e.pointerId];
    if (code) { delete held[e.pointerId]; release(code); }
  }
  window.addEventListener('pointerup', pointerUp);
  window.addEventListener('pointercancel', pointerUp);

  /* ---------- Кнопки керування ---------- */
  lockBtn.addEventListener('click', function () {
    locked = !locked;
    releaseAll();
    Object.keys(map).forEach(function (c) { map[c].disabled = locked; });
    lockBtn.setAttribute('aria-pressed', String(locked));
    lockBtn.textContent = locked ? 'Розблокувати клавіатуру' : 'Заблокувати клавіатуру';
  });
  resetBtn.addEventListener('click', function () {
    releaseAll();
    Object.keys(used).forEach(function (c) { map[c].classList.remove('is-used'); });
    used = {};
    usedCount = 0;
    state = { caps: false, num: true, scroll: false };
    lastEl.textContent = '—';
    paintToggles();
    paintCount();
  });

  paintToggles();
  paintCount();
})();
</script>

</body></html>
